Schema for SQLite:
```sql
-- Memories (mirrors JSONL but queryable)
CREATE TABLE memories (
  id TEXT PRIMARY KEY,
  type TEXT NOT NULL,
  content TEXT NOT NULL,
  original_text TEXT,
  confidence REAL,
  status TEXT DEFAULT 'active',
  timestamp TEXT,
  source_file TEXT,
  hash TEXT UNIQUE,
  superseded_by TEXT,
  pipeline_run_id TEXT
);

-- Knowledge Graph edges
CREATE TABLE graph_edges (
  id TEXT PRIMARY KEY,
  source_node TEXT NOT NULL,
  source_type TEXT NOT NULL,  -- 'file', 'memory', 'decision', 'bug', 'feature'
  target_node TEXT NOT NULL,
  target_type TEXT NOT NULL,
  relationship TEXT NOT NULL, -- 'depends_on', 'caused_by', 'relates_to', 'implements', 'supersedes'
  weight REAL DEFAULT 1.0,
  created_at TEXT
);

-- Engineering tasks
CREATE TABLE tasks (
  id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  description TEXT,
  priority TEXT,  -- 'critical', 'high', 'medium', 'low'
  status TEXT DEFAULT 'pending',  -- 'pending', 'in_progress', 'done', 'cancelled'
  source_memory_ids TEXT,  -- JSON array of memory IDs that generated this task
  risk_level TEXT,
  created_at TEXT
);

-- Risks
CREATE TABLE risks (
  id TEXT PRIMARY KEY,
  description TEXT NOT NULL,
  severity TEXT,  -- 'low', 'medium', 'high', 'critical'
  category TEXT,  -- 'architecture', 'dependency', 'security', 'performance', 'data'
  affected_files TEXT,  -- JSON array
  source_memory_ids TEXT,  -- JSON array
  status TEXT DEFAULT 'active',
  created_at TEXT
);

-- Agent run log
CREATE TABLE agent_runs (
  id TEXT PRIMARY KEY,
  agent_name TEXT NOT NULL,
  event_id TEXT,
  status TEXT,  -- 'started', 'completed', 'failed'
  input_summary TEXT,
  output_summary TEXT,
  duration_ms INTEGER,
  error TEXT,
  created_at TEXT
);
```

